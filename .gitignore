# Repository-level .gitignore for monorepo

# dependencies
/Client/node_modules
/Server/node_modules
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# production
/build
/uploads

# misc
.DS_Store

# ── Client env (CRA) ──────────────────────────────────────────────────
# .env.development and .env.production are safe to commit (no secrets, baked into bundle)
# Only the .local variants are gitignored
.env.local
.env.development.local
.env.test.local
.env.production.local

# ── Server env files (contain real secrets — never commit) ────────────
Server/.env
Server/.env.*
# Keep the example template
!Server/.env.example

npm-debug.log*
yarn-debug.log*
yarn-error.log*
