# ── Production Frontend Environment Variables ──────────────────────────
# These override .env when running a production build (npm run build)
# Update the IP/domain to match wherever your server is hosted.

# Backend API base URL (production server) — use HTTPS for secure pages
REACT_APP_API_BASE_URL=https://api.ardk.online

# Socket.IO endpoint (same server)
REACT_APP_SOCKET_URL=https://api.ardk.online

# Frontend origin
REACT_APP_CLIENT_URL=https://ardk.online
