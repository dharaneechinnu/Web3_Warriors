# ── Development Environment Variables ─────────────────────────────────
# Loaded automatically by React when running: npm start
# DO NOT commit secrets here — these values are baked into the JS bundle.

# Backend API base URL (local dev server)
REACT_APP_API_BASE_URL=http://localhost:3500

# Socket.IO endpoint (local dev server)
REACT_APP_SOCKET_URL=http://localhost:3500

# Frontend origin (local dev)
REACT_APP_CLIENT_URL=http://localhost:3000
