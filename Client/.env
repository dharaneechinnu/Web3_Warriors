# ── Frontend Environment Variables ──────────────────────────
# React requires env vars to start with REACT_APP_

# Backend API base URL
REACT_APP_API_BASE_URL=http://localhost:3500

# Socket.IO endpoint (same as API if not separate)
REACT_APP_SOCKET_URL=http://localhost:3500

# Frontend origin (used for CORS, email links, etc.)
REACT_APP_CLIENT_URL=http://localhost:3000